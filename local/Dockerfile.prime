ARG BASE=qm-sandbox-base:dev
FROM ${BASE}

COPY aws/microvm-agent/agent.mjs /opt/microvm-agent/agent.mjs

# prime-agent extensions (permission-gate etc.)
COPY prime-extensions /opt/prime-agent/extensions

# prime-agent runtime (self-contained bundle; build context "prime" = the
# prime-agent npm package directory, e.g.
# $(dirname $(which prime-agent))/../lib/node_modules/prime-agent)
COPY --from=prime /dist /opt/prime-agent/dist
COPY --from=prime /package.json /opt/prime-agent/package.json
RUN ln -sf /opt/prime-agent/dist/bundle/cli.js /usr/local/bin/prime-agent \
  && chmod +x /usr/local/bin/prime-agent \
  && mkdir -p /opt/prime-ext && cd /opt/prime-ext \
  && npm init -y >/dev/null 2>&1 \
  && npm install --no-audit --no-fund       '@agentclientprotocol/sdk@^1.3.0' '@silvia-odwyer/photon-node@^0.3.4'       chalk@^5.5.0 cli-highlight@^2.1.11 diff@^9.0.0 extract-zip@^2.0.1       file-type@^21.1.1 glob@^13.0.1 hosted-git-info@^9.0.2 ignore@^7.0.5       jiti@^2.7.0 marked@^15.0.12 minimatch@^10.2.3 proper-lockfile@^4.1.2       strip-ansi@^7.1.0 typebox@^1.1.24 undici@^7.28.0 uuid@^14.0.0       yaml@^2.9.0 zeromq@^6.1.2 \
  && mkdir -p /opt/prime-agent/dist/node_modules \
  && cp -r node_modules/* /opt/prime-agent/dist/node_modules/ \
  && rm -rf /opt/prime-ext

# uv (prime's python toolchain for kernel bootstrap)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh   && ln -sf /root/.local/bin/uv /usr/local/bin/uv

# Kernel venv: bootstrap the full environment at build time (prime's
# bootstrapVenv equivalent) so first-turn latency stays low. We install
# exactly what prime would: python 3.11 via uv, ipykernel + dill + the
# default RLM extras, the prime-agent-runtime package (from dist), and a
# .bootstrap-version marker whose runtime hash matches hashRuntimeSource so
# prime treats the venv as current and skips re-bootstrap.
# Kernel venv: full bootstrap at build time (prime's bootstrapVenv equivalent)
# so first-turn latency stays low; writes .bootstrap-version with matching
# runtime hash so prime never re-bootstraps.
COPY scripts/prime-kernel-bootstrap.sh /opt/prime-kernel-bootstrap.sh
RUN bash /opt/prime-kernel-bootstrap.sh && rm -f /opt/prime-kernel-bootstrap.sh

ENV HOME=/root
WORKDIR /root
EXPOSE 8080
CMD ["node", "/opt/microvm-agent/agent.mjs"]
