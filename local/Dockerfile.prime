ARG BASE=qm-sandbox-base:dev
FROM ${BASE}

COPY aws/microvm-agent/agent.mjs /opt/microvm-agent/agent.mjs

# prime-agent runtime (self-contained bundle; build context "prime" = the
# prime-agent checkout, see scripts/sandbox-local-build-with-prime.sh)
COPY --from=prime /packages/coding-agent/dist /opt/prime-agent/dist
COPY --from=prime /packages/coding-agent/package.json /opt/prime-agent/package.json
RUN ln -sf /opt/prime-agent/dist/bundle/cli.js /usr/local/bin/prime-agent \
  && chmod +x /usr/local/bin/prime-agent \
  && mkdir -p /opt/prime-ext && cd /opt/prime-ext \
  && npm init -y >/dev/null 2>&1 \
  && npm install --no-audit --no-fund       '@agentclientprotocol/sdk@^1.3.0' '@silvia-odwyer/photon-node@^0.3.4'       chalk@^5.5.0 cli-highlight@^2.1.11 diff@^9.0.0 extract-zip@^2.0.1       file-type@^21.1.1 glob@^13.0.1 hosted-git-info@^9.0.2 ignore@^7.0.5       jiti@^2.7.0 marked@^15.0.12 minimatch@^10.2.3 proper-lockfile@^4.1.2       strip-ansi@^7.1.0 typebox@^1.1.24 undici@^7.28.0 uuid@^14.0.0       yaml@^2.9.0 zeromq@^6.1.2 \
  && mkdir -p /opt/prime-agent/dist/node_modules \
  && cp -r node_modules/* /opt/prime-agent/dist/node_modules/ \
  && rm -rf /opt/prime-ext

# uv (prime's python toolchain for kernel bootstrap)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh   && ln -sf /root/.local/bin/uv /usr/local/bin/uv

# Kernel prewarm: run one real turn at build time so prime bootstraps the
# complete kernel venv (ipykernel + prime-agent-runtime + dill + extras) and
# writes the .bootstrap-version marker. The ready venv lands in the image
# layer, eliminating the 30-108s cold-start on first runtime turn.
# PRIME_AGENT_KERNEL_VENV is passed at build time; DEEPSEEK_API_KEY is a
# build arg (not baked into the image).
ARG DEEPSEEK_API_KEY=
RUN if [ -n "$DEEPSEEK_API_KEY" ]; then \
      echo '{"type":"prompt","message":"用 Python 计算 1+1。"}' | \
      DEEPSEEK_API_KEY="$DEEPSEEK_API_KEY" PRIME_AGENT_KERNEL_VENV=/opt/prime-kernel-venv \
      node /opt/prime-agent/dist/bundle/cli.js --mode rpc --no-session --provider deepseek --model deepseek-v4-flash \
      2>/dev/null | grep -q agent_end || true; \
      rm -rf /root/.prime/agent/sessions /root/.prime/agent/telemetry.json /root/.prime/agent/logs /root/.prime/agent/daemon-workers /tmp/prime-agent-0 2>/dev/null || true; \
    fi

ENV HOME=/root
WORKDIR /root
EXPOSE 8080
CMD ["node", "/opt/microvm-agent/agent.mjs"]
